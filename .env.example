# Copie este arquivo para .env e preencha com os seus valores.
# O arquivo .env NÃO deve ser enviado ao GitHub (já está no .gitignore).

# Desenvolvimento local: True. Produção: False.
DEBUG=True

# Gere uma chave com:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Opção 1 – banco local (PostgreSQL instalado na máquina)
POSTGRES_DB=oficina
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Opção 2 – banco hospedado (Neon). Se preenchida, substitui as variáveis acima.
# DATABASE_URL=postgresql://usuario:senha@endereco.neon.tech/oficina?sslmode=require
